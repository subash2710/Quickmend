# Database Configuration (Defaults to local SQLite database quickmend.db if empty)
DATABASE_URL=postgresql://quickmend_user:quickmend_pass@localhost:5432/quickmend_db

# Security & JWT
JWT_SECRET=quickmend-super-secret-jwt-key-2026
SECRET_KEY=quickmend-flask-secret-key-2026

# AI Configuration (OpenAI or Gemini REST API Key; Uses intelligent Fallback Mode if missing)
AI_API_KEY=

# Maps API Configuration (Google Maps or Mapbox; Uses interactive Leaflet map canvas if missing)
MAPS_API_KEY=

# PayPal Sandbox Credentials (Uses verified Sandbox mode; includes simulation mode if missing)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Server Port
PORT=5000
